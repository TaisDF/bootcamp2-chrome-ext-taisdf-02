{
  "name": "lexi-focus",
  "version": "1.2.0",
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "zip": "cd dist && zip -r ../extension.zip .",
    "package": "npm run build && npm run zip",
    "test:e2e": "playwright test --reporter=list,html",
    "test": "npm run build && npm run test:e2e",
    "ci": "npm ci && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.8.1",
    "archiver": "^7.0.1",
    "fs-extra": "^11.3.2"
  }
}
